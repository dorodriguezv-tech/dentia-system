{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npx expo-doctor)",
      "Bash(npx expo install *)",
      "Bash(npx tsc *)",
      "Bash(adb devices)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "ask": [
      "Bash(eas build *)",
      "Bash(eas submit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)"
    ]
  }
}
