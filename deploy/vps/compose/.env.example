# Copiar a .env en la misma carpeta (compose/) en el VPS. Sin secretos --
# esos van en archivos aparte bajo /etc/dentia/<proyecto>/secrets (ver
# scripts/install.sh y docker-compose.yml -> secrets:).

# Etiqueta de version a desplegar, igual a un release de GitHub (p. ej. 1.0.0).
# install.sh/deploy.sh la actualizan; no hace falta editarla a mano salvo
# para una instalacion manual.
VERSION=1.0.0

# Dominio publico de este proyecto: app.dentia.digital (produccion) o
# demo.dentia.digital (pruebas).
DOMAIN=app.dentia.digital

# Nombre corto de este proyecto de Docker Compose -- separa los secretos y
# volumenes de otro proyecto en el MISMO VPS (p. ej. dentia-demo y
# dentia-prod conviviendo, sec. 12 del instructivo). Tambien el prefijo que
# usa Docker Compose para nombrar contenedores/volumenes/red.
COMPOSE_PROJECT_NAME=dentia-prod
PROJECT_NAME=dentia-prod

# Namespace de GitHub Container Registry donde se publicaron las imagenes
# (ghcr.io/<esto>/dentia-api, ghcr.io/<esto>/dentia-web) -- el usuario/
# organizacion de GitHub dueno del repositorio.
GHCR_NAMESPACE=dorodriguezv-tech
