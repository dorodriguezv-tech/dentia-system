# Plantilla de produccion (docs/INSTALACION_PRODUCCION.md). Copiar a
# frontend\.env.production en el SERVIDOR antes de "npm run build" -- Vite solo
# lee este archivo durante la compilacion, no en tiempo de ejecucion.

VITE_API_URL=https://app.clinica.emo/api/v1

# Clave PUBLICA (sitekey) de Cloudflare Turnstile -- distinta de
# TURNSTILE_SECRET_KEY del backend. Vacia = el login no muestra el captcha (y
# debe estar vacia TURNSTILE_SECRET_KEY tambien, o el login quedaria imposible).
VITE_TURNSTILE_SITE_KEY=<sitekey-publica-de-turnstile>
