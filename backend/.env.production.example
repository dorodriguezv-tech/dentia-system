# Plantilla de produccion (docs/INSTALACION_PRODUCCION.md). Copiar a backend\.env
# en el SERVIDOR unicamente y rellenar los valores entre <> -- este archivo de
# ejemplo si se versiona, pero backend\.env real NUNCA (ya esta en .gitignore).

ENVIRONMENT=production

# Contraseña del rol "dentia" creado en el paso de PostgreSQL del instructivo
# (no la del superusuario postgres, esa no va aqui). La contrasena real NUNCA
# va en un archivo versionado -- consultarla en el gestor de contrasenas.
DATABASE_URL=postgresql+asyncpg://dentia:<contrasena-del-rol-dentia>@localhost:5432/dentia

# Generar con: python -c "import secrets; print(secrets.token_hex(48))"
# (64+ caracteres). Sin esto el backend no arranca en produccion (ver
# app/core/config.py::_require_real_jwt_secret_in_production).
JWT_SECRET=<generar-uno-propio-de-64-o-mas-caracteres>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# Dominio real de la clinica, nunca "*". Si el dominio cambia, este es el unico
# lugar que hay que tocar en el backend.
CORS_ORIGINS=["https://app.clinica.emo"]

STORAGE_DIR=C:/DentiaData/storage

# Asistente de IA deshabilitado en esta fase (ver docs/INSTALACION_PRODUCCION.md
# sec. "Agente de IA").
AI_ENABLED=false
AI_FAKE_MODE=false
AI_STORE_AUDIO=false

# Cloudflare Turnstile (captcha del login, protege las 3 cuentas incluido
# admin): clave SECRETA del sitio en el panel de Cloudflare (Turnstile ->
# Widgets). Vacia = el login no exige captcha (asi se queda en desarrollo).
TURNSTILE_SECRET_KEY=<clave-secreta-de-turnstile>
