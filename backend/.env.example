# Copia este archivo a .env y ajusta los valores. Nunca subas .env a git.

ENVIRONMENT=development

# Base de datos
DATABASE_URL=postgresql+asyncpg://dentia:dentia@localhost:5432/dentia
POSTGRES_USER=dentia
POSTGRES_PASSWORD=dentia
POSTGRES_DB=dentia

# Seguridad
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# CORS (lista separada por comas, se interpreta como JSON en pydantic-settings)
CORS_ORIGINS=["http://localhost:5174"]

# Archivos
STORAGE_DIR=../storage

# Asistente de IA local (Ollama + faster-whisper)
AI_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_S=120
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AI_STORE_AUDIO=false
AI_SUGGESTION_TTL_HOURS=24
# Modelo e idle timeout DEDICADOS a la ruta LLM de voz de Dentia (13.5, sec. 8
# del diseno) -- agenda por frase libre, mas corto/rapido que el dictado
# clinico completo (OLLAMA_MODEL). qwen2.5:3b en equipos sin GPU.
OLLAMA_INTENT_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=-1
# Solo para Playwright (e2e/): respuestas deterministas sin Ollama/Whisper reales.
# NUNCA en true en desarrollo normal ni en produccion.
AI_FAKE_MODE=false

# Asistente de voz "Dentia" (Fase 13) -- docs/05_ASISTENTE_DENTIA_VOZ_CONVERSACIONAL.md
VOICE_ENABLED=true
VOICE_WAKE_ENGINE=whisper_tiny
VOICE_WAKE_MODEL_SIZE=tiny
VOICE_TTS_ENGINE=piper
VOICE_TTS_MODEL=es_MX-claude-high
# Descargar con: python -m piper.download_voices es_MX-claude-high --download-dir ../voices
VOICE_TTS_MODEL_PATH=../voices/es_MX-claude-high.onnx
# Solo para pruebas/Playwright, igual que AI_FAKE_MODE. NUNCA en true en produccion.
VOICE_FAKE_MODE=false
# Cuenta regresiva de la confirmacion implicita (nivel 2) y ventana de
# seguimiento (sec. 2.1, 3 y 8) -- 13.3 "Captura en consulta".
VOICE_CAPTURE_COUNTDOWN_S=3.0
VOICE_FOLLOWUP_S=8.0
