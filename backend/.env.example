# Copia este archivo a .env y ajusta los valores. Nunca subas .env a git.

ENVIRONMENT=development

# Base de datos
DATABASE_URL=postgresql+asyncpg://dentia:dentia@localhost:5432/dentia
POSTGRES_USER=dentia
POSTGRES_PASSWORD=dentia
POSTGRES_DB=dentia

# Seguridad
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# CORS (lista separada por comas, se interpreta como JSON en pydantic-settings)
CORS_ORIGINS=["http://localhost:5174"]

# Archivos
STORAGE_DIR=../storage

# Asistente de IA local (Ollama + faster-whisper)
AI_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_S=120
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AI_STORE_AUDIO=false
AI_SUGGESTION_TTL_HOURS=24
